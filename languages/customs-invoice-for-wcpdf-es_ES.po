#, php-format
msgid "%d%%"
msgstr "%d %%"

msgid "Custom values"
msgstr "Valores personalizados"

msgid "Every amount of the order (lines, shipping and taxes) is scaled to this percentage. Choose “Custom values” to type them by hand."
msgstr "Todos los importes del pedido (líneas, envío e impuestos) se reducen a este porcentaje. Elige «Valores personalizados» para escribirlos a mano."

msgid "Amounts typed by hand. No tax rows are printed: total = lines + shipping."
msgstr "Importes escritos a mano. No se imprimen filas de impuestos: total = líneas + envío."
